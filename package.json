{
  "name": "self-improvement-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A fully local-first self-improvement tracker.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.14.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config=playwright.production.config.ts",
    "cap:sync": "npm run build && cap sync android",
    "verify:n0:env": "node scripts/verify-n0-environment.mjs",
    "verify:n0:network": "node scripts/verify-network-boundary.mjs",
    "verify:n0:android-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-smoke.ps1",
    "test:n0:android-smoke-runner": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-smoke-runner.ps1"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/share": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
